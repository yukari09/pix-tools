---
import { SITE } from '../data/tools';

const toolLinks: [string, string][] = [
  ['AI 抠图去背景', '/removebg'],
  ['图片压缩', '/compress'],
  ['格式转换', '/convert'],
  ['图片缩放', '/resize'],
];
const moreLinks: [string, string][] = [
  ['九宫格切图', '/nine-grid'],
  ['图片加水印', '/watermark'],
  ['图片滤镜', '/filters'],
];
const hot: [string, string][] = [
  ['在线抠图', '/removebg'],
  ['图片压缩', '/compress'],
  ['WebP 转 JPG', '/convert'],
  ['朋友圈九宫格', '/nine-grid'],
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <a href="/" class="brand">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h10l6 6v10H4z" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="8" y="10" width="6" height="6" fill="currentColor"/></svg>
          PixTools
        </a>
        <p>七种图片处理，全部在浏览器里完成。图片不上传、不留存，服务器不接收文件。</p>
      </div>
      <div class="footer-col">
        <h3>图片工具</h3>
        {toolLinks.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
      <div class="footer-col">
        <h3>更多工具</h3>
        {moreLinks.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
      <div class="footer-col">
        <h3>热门</h3>
        {hot.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 {SITE.name} · 浏览器本地处理</span>
      <span class="footer-badge"><span class="dot" style="width:6px;height:6px;border-radius:50%;background:var(--local-green-dark);display:inline-block"></span>0 上传 · 0 账号</span>
      <span><a href="/">首页</a> · <a href="/sitemap.xml">Sitemap</a></span>
    </div>
  </div>
</footer>
