---
import { TOOLS } from '../data/tools';

interface Props {
  current?: string;
}
const { current } = Astro.props;
const others = TOOLS.filter((t) => t.slug !== current);
---
<div class="related">
  <h2>接着做下一件事</h2>
  <div class="related-links">
    {others.map((t) => (
      <a href={`/${t.slug}`} style={`--accent:${t.accent}`}><i></i>{t.name}</a>
    ))}
  </div>
</div>
