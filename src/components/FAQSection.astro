---
interface Props {
  faqs: [string, string][];
  title: string;
}
const { faqs, title } = Astro.props;
---
<section class="faq-section">
  <h2>常见问题</h2>
  <p class="faq-sub">关于{title}的常见疑问，这里一次说清。</p>
  {faqs.map(([q, a], i) => (
    <details class="faq-item" open={i === 0}>
      <summary>{q}</summary>
      <div class="faq-a">{a}</div>
    </details>
  ))}
</section>
