---
import BaseLayout from './BaseLayout.astro';
import FAQSection from '../components/FAQSection.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { SITE, toolBySlug } from '../data/tools';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tool = toolBySlug(slug);
if (!tool) throw new Error(`Unknown tool slug: ${slug}`);

const url = `${SITE.domain}/${slug}`;

// featureList 只从该工具现有 cardDesc / faqs / metric 文案中摘取
const FEATURES: Record<string, string[]> = {
  removebg: [
    '自动识别图片主体并去除背景',
    '输出透明背景 PNG',
    '浏览器本地运行 AI 抠图模型',
  ],
  compress: [
    '压缩 JPG、PNG、WebP 图片',
    '压缩质量可以自己调',
    '实时预览压缩前后大小对比',
  ],
  convert: [
    'PNG、JPG、WebP 三种格式互转',
    'WebP 转 JPG',
    '转换时使用高质量编码',
  ],
  resize: [
    '按百分比或指定尺寸缩放图片',
    '保持宽高比',
    '双三次插值',
  ],
  'nine-grid': [
    '把一张大图平均切成 3×3 共 9 张小图',
    '支持 2×2 和 4×4 网格',
    '完全在浏览器本地运行',
  ],
  watermark: [
    '文字或 Logo 水印',
    '自定义字号、颜色、透明度、位置',
    '支持平铺防裁剪',
  ],
  filters: [
    '亮度、对比度、饱和度、模糊四项手动调节',
    '黑白、复古、反色、鲜艳、褪色五组一键预设',
    '以 PNG 无损格式导出',
  ],
};

const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.name,
    url,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    inLanguage: 'zh-CN',
    image: SITE.domain + '/assets/og-cover.png',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    description: tool.pageDesc,
    featureList: FEATURES[slug] ?? [],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '全部工具', item: SITE.domain + '/' },
      { '@type': 'ListItem', position: 2, name: tool.category, item: SITE.domain + '/?cat=' + encodeURIComponent(tool.category) },
      { '@type': 'ListItem', position: 3, name: tool.name, item: url },
    ],
  },
];
---

<BaseLayout
  title={tool.pageTitle}
  description={tool.pageDesc}
  canonical={`/${slug}`}
  accent={tool.accent}
  jsonLd={[
    ...baseSchema,
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: tool.faqs.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ]}
>
  <main id="main" class="container tool-page" tabindex="-1">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">全部工具</a><span class="sep">/</span><a href={`/?cat=${encodeURIComponent(tool.category)}`}>{tool.category}</a><span class="sep">/</span><span>{tool.name}</span>
    </nav>

    <slot name="hero" />

    <div class="msg-error" role="alert"></div>
    <div class="status" id="status" aria-live="polite">
      <div class="spinner"></div>
      <div class="progress-track"><div class="progress-bar" id="statusBar"></div></div>
      <div class="status-text" id="statusText">处理中…</div>
    </div>

    <slot />

    <div class="ad-slot">
      <span class="ad-label">广告</span>
      <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-8834563225975418" data-ad-slot="2460726858" data-ad-format="auto" data-full-width-responsive="true"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

    <FAQSection faqs={tool.faqs} title={tool.name} />
    <RelatedTools current={slug} />
  </main>
</BaseLayout>
