---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/tools';

interface Props {
  title: string;
  description: string;
  canonical: string;
  jsonLd?: object[];
  noindex?: boolean;
  accent?: string;
}
const { title, description, canonical, jsonLd = [], noindex = false, accent = '#E4442A' } = Astro.props;
const url = SITE.domain + canonical;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <meta name="robots" content="index,follow">}
  <link rel="canonical" href={url}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#F6F7F5">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title.replace(' | PixTools', '')}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={url}>
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:locale" content="zh_CN">
  <meta property="og:image" content={SITE.domain + '/assets/og-cover.png'}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="PixTools 图片工具箱：抠图、压缩、转格式、缩放、九宫格、水印、滤镜，全部在浏览器本地完成，图片不出本机。">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={SITE.domain + '/assets/og-cover.png'}>
  <meta name="twitter:image:alt" content="PixTools 图片工具箱：抠图、压缩、转格式、缩放、九宫格、水印、滤镜，全部在浏览器本地完成，图片不出本机。">
  <link rel="stylesheet" href="/css/style.css">
  {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)}></script>)}
  <!-- Privacy-friendly analytics -->
  <script defer src="https://analytics.morio.cc/script.js" data-website-id="902f795f-3335-48b7-a948-2bfa576c2da1"></script>
  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8834563225975418" crossorigin="anonymous"></script>
</head>
<body style={`--accent:${accent}`}>
  <a class="skip" href="#main">跳到正文</a>
  <Header />
  <slot />
  <Footer />
</body>
</html>
