---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — 页面未找到 | PixTools"
  description="页面不存在或已被移动，返回 PixTools 图片工具箱继续使用在线图片工具。"
  canonical="/404"
  noindex={true}
>
  <main id="main" class="container notfound" tabindex="-1">
    <h1>404 · 走错站了。</h1>
    <p>页面不存在或已被移动。回到全部工具，继续处理你的图片。</p>
    <a href="/" class="btn btn-primary">回到全部工具</a>
  </main>
</BaseLayout>
