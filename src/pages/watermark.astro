---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="watermark">
  <div slot="blurb">给电商原图、摄影作品、设计稿一键添加<strong>文字水印</strong>或<strong>Logo 水印</strong>,支持自定义样式、透明度、位置和平铺,防搬运必备。全部在浏览器本地完成,图片不上传服务器。</div>

  <div class="dropzone hidden-after-upload" id="dropzone">
    <div class="dropzone-icon">🖼</div>
    <div class="dropzone-text">点击选择图片或拖拽图片到此处</div>
    <div class="dropzone-sub">JPG / PNG / WebP</div>
    <input type="file" id="fileInput" accept="image/*">
  </div>

  <div class="work-area hidden" id="workArea">
    <div class="controls">
      <div class="control">
        <label>水印类型</label>
        <select id="wmType">
          <option value="text">文字水印</option>
          <option value="logo">Logo 水印</option>
        </select>
      </div>
      <div class="control" id="textCtrl" style="flex:1;min-width:220px">
        <label for="wmText">水印文字</label>
        <input type="text" id="wmText" value="© PixTools" style="padding:8px 10px;border:1px solid #cbd5e1;border-radius:8px;font-size:14px">
      </div>
      <div class="control hidden" id="logoCtrl">
        <label for="logoInput">Logo 图片</label>
        <input type="file" id="logoInput" accept="image/*" style="font-size:12px">
      </div>
      <div class="control">
        <label for="wmSize">字号 <span id="wmSizeVal">40</span>px</label>
        <input type="range" id="wmSize" min="12" max="200" value="40">
      </div>
      <div class="control">
        <label for="wmOpacity">透明度 <span id="wmOpacityVal">60</span>%</label>
        <input type="range" id="wmOpacity" min="5" max="100" value="60">
      </div>
      <div class="control">
        <label for="wmColor">颜色</label>
        <input type="color" id="wmColor" value="#ffffff" style="width:52px;height:38px;padding:2px;border:1px solid #cbd5e1;border-radius:8px">
      </div>
      <div class="control">
        <label for="wmPos">位置</label>
        <select id="wmPos">
          <option value="tl">左上</option>
          <option value="tc">顶部居中</option>
          <option value="tr">右上</option>
          <option value="ml">中左</option>
          <option value="mc">居中</option>
          <option value="mr">中右</option>
          <option value="bl">左下</option>
          <option value="bc">底部居中</option>
          <option value="br">右下</option>
        </select>
      </div>
      <div class="control">
        <label for="wmTile">平铺</label>
        <select id="wmTile"><option value="false">否</option><option value="true">是(防裁剪)</option></select>
      </div>
      <button class="btn btn-primary" id="btnExport">⬇ 导出加水印图</button>
    </div>
    <div class="compare">
      <div class="compare-box">
        <h3>原图</h3>
        <img id="previewOrig" alt="原图">
        <div class="compare-meta" id="metaOrig"></div>
      </div>
      <div class="compare-box">
        <h3>加水印后</h3>
        <img id="previewResult" alt="加水印后">
        <div class="compare-meta" id="metaResult"></div>
      </div>
    </div>
  </div>
  <script is:inline src="/js/common.js"></script>
  <script is:inline src="/js/watermark.js"></script>
</ToolLayout>