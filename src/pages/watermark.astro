---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="watermark">
  <section slot="hero" class="tool-hero">
    <div class="tool-hero__copy">
      <h1>图片加水印，<br>防搬运再发出去。</h1>
      <p class="tool-benefit">给电商原图、摄影作品添加文字或 Logo 水印，支持字号、透明度、位置和平铺。防搬运，图片不上传。</p>
      <div class="dropzone" id="dropzone" role="button" tabindex="0">
        <span class="dropzone__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 16V4"/><path d="m7 9 5-5 5 5"/><path d="M5 15v4h14v-4"/></svg>
        </span>
        <span class="dropzone__main">
          <b>点击选择图片，或拖到这里</b>
          <span>JPG / PNG / WebP · 图片不离开本机</span>
        </span>
        <input type="file" id="fileInput" accept="image/*">
      </div>
      <p class="tool-note">文字 / Logo · 平铺防裁剪 · 0 上传</p>
    </div>

    <div class="demo-stage stage-watermark">
      <span class="stage-note">示例 · 平铺水印</span>
      <img src="/assets/demo/src-pixdemo.jpg" alt="平铺水印示例：海滩照片上的 © 示例" loading="lazy">
      <div class="wm-overlay" aria-hidden="true">
        <span>© 示例</span><span>© 示例</span><span>© 示例</span><span>© 示例</span>
        <span>© 示例</span><span>© 示例</span><span>© 示例</span><span>© 示例</span>
        <span>© 示例</span><span>© 示例</span><span>© 示例</span><span>© 示例</span>
        <span>© 示例</span><span>© 示例</span><span>© 示例</span><span>© 示例</span>
      </div>
      <div class="pos-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i class="on"></i><i></i><i></i><i></i><i></i></div>
    </div>
  </section>

  <section class="work-section hidden" id="workArea">
    <div class="work-head"><h2>水印设置</h2><div class="work-head-actions"><span>本地处理 · 0 上传</span><button class="btn btn-secondary btn-sm" type="button" data-reset>换一张</button></div></div>
<div class="work-grid">
        <div class="controls">
          <div class="control">
            <label for="wmType">水印类型</label>
            <select id="wmType"><option value="text">文字水印</option><option value="logo">Logo 水印</option></select>
          </div>
          <div class="control" id="textCtrl">
            <label for="wmText">水印文字</label>
            <input type="text" id="wmText" value="© 你的名字">
          </div>
          <div class="control hidden" id="logoCtrl">
            <label for="logoInput">Logo 图片</label>
            <input type="file" id="logoInput" accept="image/*">
          </div>
          <div class="control">
            <label for="wmSize">字号 <span id="wmSizeVal">40</span>px</label>
            <input type="range" id="wmSize" min="12" max="200" value="40">
          </div>
          <div class="control">
            <label for="wmOpacity">透明度 <span id="wmOpacityVal">60</span>%</label>
            <input type="range" id="wmOpacity" min="5" max="100" value="60">
          </div>
          <div class="control">
            <label for="wmColor">颜色</label>
            <input type="color" id="wmColor" value="#ffffff">
          </div>
          <div class="control">
            <label for="wmPos">位置</label>
            <select id="wmPos">
              <option value="tl">左上</option><option value="tc">顶部居中</option><option value="tr">右上</option>
              <option value="ml">中左</option><option value="mc">居中</option><option value="mr">中右</option>
              <option value="bl">左下</option><option value="bc">底部居中</option><option value="br">右下</option>
            </select>
          </div>
          <div class="control">
            <label for="wmTile">平铺</label>
            <select id="wmTile"><option value="false">否</option><option value="true">是（防裁剪）</option></select>
          </div>
          <div class="controls-actions">
            <button class="btn btn-primary" id="btnExport">导出加水印图</button>
          </div>
        </div>
        <div class="compare">
          <div class="compare-box">
            <h3>原图</h3>
            <img id="previewOrig" src="/assets/demo/src-pixdemo.jpg" alt="原图">
            <div class="compare-meta" id="metaOrig"></div>
          </div>
          <div class="compare-box">
            <h3>加水印后</h3>
            <img id="previewResult" src="/assets/demo/src-pixdemo.jpg" alt="加水印后">
            <div class="compare-meta" id="metaResult"></div>
          </div>
        </div>
      </div>
  </section>

  <div class="steps">
    <div class="step"><span class="n">01</span><div><b>放入图片</b><p>电商原图、摄影作品都行，文件不上传。</p></div></div>
    <div class="step"><span class="n">02</span><div><b>调水印</b><p>文字或 Logo、字号、透明度、位置；需要防裁剪就平铺。</p></div></div>
    <div class="step"><span class="n">03</span><div><b>导出</b><p>输出带水印的 PNG，原图保留不动。</p></div></div>
  </div>

  <script is:inline src="/js/common.js"></script>
  <script is:inline src="/js/watermark.js"></script>
</ToolLayout>
