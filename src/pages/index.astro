---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, TOOLS, HOT_TERMS } from '../data/tools';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.domain + '/',
    description: '免费在线图片处理工具:AI 抠图、九宫格切图、图片压缩、格式转换、缩放、加水印、滤镜。全部浏览器本地处理,图片不上传服务器。',
    inLanguage: 'zh-CN',
    publisher: { '@type': 'Organization', name: SITE.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'PixTools 全部工具',
    itemListElement: TOOLS.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.cardTitle,
      url: `${SITE.domain}/${t.slug}`,
    })),
  },
];
---

<BaseLayout
  title="PixTools 图片工具箱 — 免费在线图片压缩、抠图、九宫格、格式转换"
  description="免费在线图片处理工具:AI 一键抠图、九宫格切图、图片压缩、格式转换、缩放、加水印、滤镜。全部在浏览器本地完成,图片不上传服务器,保护隐私。"
  canonical="/"
  jsonLd={jsonLd}
>
  <main class="container">
    <section class="hero">
      <h1>免费在线图片工具箱</h1>
      <p class="hero-sub">AI 抠图 · 压缩 · 格式转换 · 缩放 · 九宫格 · 水印 · 滤镜</p>
      <p class="hero-desc">所有处理都在你的浏览器本地完成,<strong>图片不会上传到任何服务器</strong>。无账号、无限制、完全免费。</p>
    </section>

    <section class="tool-grid">
      {TOOLS.map((t) => (
        <a href={`/${t.slug}`} class="tool-card">
          {t.hotTag && <span class="tool-tag">{t.hotTag}</span>}
          <div class="tool-icon" style={`background:${t.iconBg};color:${t.iconColor}`}>{t.icon}</div>
          <h2 class="tool-name">{t.cardTitle}</h2>
          <p class="tool-desc">{t.cardDesc}</p>
        </a>
      ))}
    </section>

    <section class="hot-searches">
      <h2>热门图片工具</h2>
      <div class="hot-chips">
        {HOT_TERMS.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
    </section>

    <section class="features">
      <div class="feature">
        <h3>🔒 隐私安全</h3>
        <p>图片全程不离开你的设备,服务器零接触,放心处理敏感图片。</p>
      </div>
      <div class="feature">
        <h3>⚡ 免费无限制</h3>
        <p>不注册、不登录、无水印,处理次数和文件大小完全开放。</p>
      </div>
      <div class="feature">
        <h3>🌍 随处可用</h3>
        <p>任何现代浏览器直接打开即用,手机电脑都支持,无需安装。</p>
      </div>
    </section>
  </main>
</BaseLayout>